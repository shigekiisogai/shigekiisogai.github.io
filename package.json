{
  "name": "shigeki-isogai-personal-site",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "node scripts/build.mjs github",
    "build:github": "node scripts/build.mjs github",
    "build:github:root": "node scripts/build.mjs github",
    "build:cloudflare": "node scripts/build.mjs cloudflare",
    "test": "node --test tests/*.test.mjs",
    "check:links": "node scripts/check-site.mjs",
    "check:content": "node scripts/check-content.mjs",
    "check:publish": "node scripts/check-publish.mjs"
  },
  "devDependencies": {
    "astro": "7.4.2",
    "cheerio": "1.2.0",
    "turndown": "7.2.4",
    "wrangler": "4.152.0"
  },
  "overrides": {
    "miniflare": {
      "undici": "7.30.1"
    }
  }
}
